# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your_bot_token_here

# Webtop / SmartSchool credentials
WEBTOP_USERNAME=your_username
WEBTOP_PASSWORD=your_password

# Encryption key - institution-specific.
# Leave empty to use the default SmartSchool value.
# If login fails, capture this from browser DevTools → Network → login request body → "data" field.
WEBTOP_DATA=

# School server URL (leave empty for default SmartSchool Israel)
WEBTOP_BASE_URL=

# Telegram user/chat IDs allowed to use this bot (comma-separated).
# Access is fail-closed: leaving this empty denies EVERYONE. Until it is set,
# the bot answers /myid and nothing else.
# Find your ID by sending /myid to your own bot, or messaging @userinfobot.
ALLOWED_CHAT_IDS=
